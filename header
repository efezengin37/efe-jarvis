
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EFE JARVIS AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#060b16;color:#eaf4ff;font-family:Arial,sans-serif}
button,input,select{font:inherit}
button{cursor:pointer;border:0;border-radius:10px;padding:12px;background:#06b6d4;color:#04111b;font-weight:bold}
button:disabled{opacity:.5;cursor:wait}
.app{display:flex;min-height:100vh}
.sidebar{width:250px;flex-shrink:0;background:#091322;border-right:1px solid #1a3048;padding:20px;display:flex;flex-direction:column;gap:14px}
.brand{font-size:21px;font-weight:bold;letter-spacing:2px;color:#22d3ee;padding:8px 0 18px}
.secondary{background:#14263b;color:#eaf4ff;border:1px solid #263e59}
#history{display:flex;flex-direction:column;gap:8px;overflow:auto}
.chatitem{display:flex;gap:5px}
.chatitem button:first-child{flex:1;min-width:0;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.delete{background:#351c2a;color:#ffb4c7;padding:10px}
.empty{color:#8499b2;font-size:12px;line-height:1.6}
.main{flex:1;min-width:0;padding:20px;display:flex;justify-content:center}
.panel{width:min(850px,100%);height:calc(100vh - 40px);min-height:520px;background:#0b1627;border:1px solid #1a3048;border-radius:20px;display:flex;flex-direction:column;overflow:hidden}
header{display:flex;align-items:center;gap:14px;padding:20px;border-bottom:1px solid #1a3048}
.logo{width:48px;height:48px;flex-shrink:0;border:2px solid #22d3ee;border-radius:15px;display:grid;place-items:center;color:#22d3ee;font-weight:bold;font-size:18px}
h1{font-size:21px;letter-spacing:2px;margin:0}
.status{font-size:11px;color:#5eead4;margin-top:7px}
.settings{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:15px 20px;border-bottom:1px solid #1a3048}
.field{display:flex;flex-direction:column;gap:7px}
.field label{font-size:12px;color:#91a8c2}
input,select{width:100%;min-width:0;background:#07111f;border:1px solid #29435e;color:#f1f7ff;padding:13px;border-radius:11px;outline:none}
input:focus,select:focus{border-color:#22d3ee}
#messages{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:14px}
.msg{max-width:90%;padding:13px 16px;border-radius:15px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.55}
.bot{align-self:flex-start;background:#14263b;border:1px solid #203b55}
.user{align-self:flex-end;background:#075985}
form{display:flex;gap:10px;padding:15px;border-top:1px solid #1a3048}
form input{flex:1}
#send{min-width:100px}
footer{text-align:center;color:#7188a3;font-size:11px;padding:0 10px 12px}
@media(max-width:650px){
 .app{display:block}
 .sidebar{width:100%;padding:12px;border-right:0;border-bottom:1px solid #1a3048}
 .brand{padding:4px 0}
 #history{flex-direction:row}
 .chatitem{min-width:170px}
 .main{padding:8px}
 .panel{height:76vh;min-height:460px}
 header{padding:14px}
 .settings{padding:12px;gap:8px}
 #messages{padding:13px}
 form{padding:10px}
 #send{min-width:75px}
}
@media(max-width:380px){
 .settings{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="app">
 <aside class="sidebar">
  <div class="brand">EFE JARVIS</div>
  <button id="newChat">+ Yeni sohbet</button>
  <div style="font-size:12px;color:#8499b2">SON 10 SOHBET</div>
  <div id="history"></div>
  <div class="empty">Sohbetler bu tarayıcıda saklanır.</div>
 </aside>

 <main class="main">
  <section class="panel">
   <header>
    <div class="logo">EJ</div>
    <div>
     <h1>EFE JARVIS</h1>
     <div class="status">● YAPAY ZEKÂ ÇEVRİM İÇİ</div>
    </div>
   </header>

   <div class="settings">
    <div class="field">
     <label for="character">KARAKTERİNİ SEÇ</label>
     <input id="character" value="Recep İvedik" maxlength="80" placeholder="Örn. Komik bir karakter">
    </div>
    <div class="field">
     <label for="style">KONUŞMA TARZI</label>
     <select id="style">
      <option>Komik</option>
      <option>Sokak ağzı</option>
      <option selected>Samimi</option>
      <option>Ciddi</option>
      <option>Bilge</option>
     </select>
    </div>
   </div>

   <div id="messages"></div>

   <form id="form">
    <input id="input" placeholder="Jarvis'e bir şey sor..." autocomplete="off" required>
    <button id="send" type="submit">GÖNDER</button>
   </form>
   <footer>EFE JARVIS · Kişisel yapay zekâ asistanın</footer>
  </section>
 </main>
</div>

<script>
const form = document.getElementById('form');
const input = document.getElementById('input');
const messagesEl = document.getElementById('messages');
const send = document.getElementById('send');
const historyEl = document.getElementById('history');
const characterEl = document.getElementById('character');
const styleEl = document.getElementById('style');
const STORAGE_KEY = 'efeJarvisChatsV2';

let chats = [];
let activeId = null;
let busy = false;

try {
  chats = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
  if (!Array.isArray(chats)) chats = [];
} catch {
  chats = [];
}

function saveChats() {
  chats = chats.slice(0, 10);
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(chats));
  } catch {}
  renderHistory();
}

function makeId() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

function createChat() {
  const chat = {
    id: makeId(),
    title: 'Yeni sohbet',
    updated: Date.now(),
    messages: []
  };
  chats.unshift(chat);
  chats = chats.slice(0, 10);
  activeId = chat.id;
  saveChats();
  renderMessages();
  input.focus();
}

function currentChat() {
  return chats.find(c => c.id === activeId);
}

function renderHistory() {
  historyEl.replaceChildren();

  if (!chats.length) {
    const p = document.createElement('div');
    p.className = 'empty';
    p.textContent = 'Henüz sohbet yok.';
    historyEl.appendChild(p);
    return;
  }

  chats.forEach(chat => {
    const row = document.createElement('div');
    row.className = 'chatitem';

    const open = document.createElement('button');
    open.className = 'secondary';
    open.textContent = chat.title || 'Yeni sohbet';
    open.title = open.textContent;
    open.onclick = () => {
      if (busy) return;
      activeId = chat.id;
      renderHistory();
      renderMessages();
    };

    const del = document.createElement('button');
    del.className = 'delete';
    del.textContent = '×';
    del.title = 'Sohbeti sil';
    del.onclick = () => {
      if (busy) return;
      if (!confirm('Bu sohbet silinsin mi?')) return;
      chats = chats.filter(c => c.id !== chat.id);
      if (activeId === chat.id) activeId = chats[0]?.id || null;
      if (!activeId) createChat();
      else {
        saveChats();
        renderMessages();
      }
    };

    if (chat.id === activeId) open.style.borderColor = '#22d3ee';
    row.append(open, del);
    historyEl.appendChild(row);
  });
}

function addMessage(text, who) {
  const el = document.createElement('div');
  el.className = 'msg ' + who;
  el.textContent = text;
  messagesEl.appendChild(el);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}

function renderMessages() {
  messagesEl.replaceChildren();
  const chat = currentChat();

  if (!chat || !chat.messages.length) {
    const character = characterEl.value.trim() || 'Efe Jarvis';
    addMessage(
      'Merhaba! Ben senin yapay zekâ asistanınım. ' +
      'Seçtiğin karakter: ' + character +
      '. Bana istediğin soruyu sorabilirsin!',
      'bot'
    );
    return;
  }

  chat.messages.forEach(m => {
    addMessage(m.content, m.role === 'user' ? 'user' : 'bot');
  });
}

function moveChatToTop(chat) {
  chat.updated = Date.now();
  chats = chats.filter(c => c.id !== chat.id);
  chats.unshift(chat);
  chats = chats.slice(0, 10);
  activeId = chat.id;
}

document.getElementById('newChat').onclick = () => {
  if (busy) return;
  createChat();
};

characterEl.addEventListener('change', () => {
  if (!currentChat() || !currentChat().messages.length) renderMessages();
});

form.addEventListener('submit', async e => {
  e.preventDefault();
  if (busy) return;

  const message = input.value.trim();
  if (!message) return;

  if (!currentChat()) createChat();
  const chat = currentChat();
  const character = characterEl.value.trim() || 'Efe Jarvis';
  const style = styleEl.value;

  chat.messages.push({role: 'user', content: message});
  if (chat.title === 'Yeni sohbet') chat.title = message.slice(0, 38);

  moveChatToTop(chat);
  saveChats();
  renderMessages();
  input.value = '';
  busy = true;
  send.disabled = true;
  send.textContent = '...';

  try {
    const response = await fetch('/chat', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        message: message,
        character: character,
        style: style,
        history: chat.messages.slice(-21, -1)
      })
    });

    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Cevap alınamadı.');

    chat.messages.push({
      role: 'assistant',
      content: data.reply || 'Cevap oluşturulamadı.'
    });

    moveChatToTop(chat);
    saveChats();
    renderMessages();
  } catch (err) {
    addMessage('Hata: ' + (err.message || 'Sunucuya bağlanılamadı.'), 'bot');
  } finally {
    busy = false;
    send.disabled = false;
    send.textContent = 'GÖNDER';
    input.focus();
  }
});

if (chats.length) {
  activeId = chats[0].id;
  renderHistory();
  renderMessages();
} else {
  createChat();
}
</script>
</body>
</html>
